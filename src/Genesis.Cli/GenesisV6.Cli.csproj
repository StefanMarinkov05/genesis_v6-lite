  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <ProjectReference Include="..\Genesis.Core\GenesisV6.Core.csproj" />
  </ItemGroup>
</Project>

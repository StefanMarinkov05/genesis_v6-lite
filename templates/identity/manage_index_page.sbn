@page
@model IndexModel
@{
    ViewData["Title"] = "Профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
{{~
has_pfp = false
for ep in spec.identity.application_user.extra_properties; if ep.name == "ProfilePicturePath"; has_pfp = true; end; end
~}}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Потребителско име" disabled />
                <label asp-for="Username" class="form-label">Потребителско име</label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Телефон" />
                <label asp-for="Input.PhoneNumber" class="form-label">Телефон</label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary {{ variation.axes.button_shape }}">Запази</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

{{~ if has_pfp ~}}
<div class="row mt-4">
    <div class="col-md-6">
        <h5>Профилна снимка</h5>
        <form asp-area="Client" asp-controller="Profiles" asp-action="ChangePicture" method="post" enctype="multipart/form-data" class="mb-2">
            <div class="mb-2">
                <input class="form-control" type="file" name="picture" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Качи нова снимка</button>
        </form>
        <form asp-area="Client" asp-controller="Profiles" asp-action="RemovePicture" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm">Изтрий текущата снимка</button>
        </form>
    </div>
</div>
{{~ end ~}}

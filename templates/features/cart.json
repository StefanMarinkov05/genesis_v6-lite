{
  "_comment": "Feature 'cart': a per-user shopping cart over the primary model (add, remove, total), without checkout. Its CartItem MUST stay identical to orders.json's - enabling both merges one CartItem (MergeFragment skips identical duplicates). The CartController and Cart views are emitted by EmitControllersViewsStage when cart or orders is on; orders adds checkout and order history (changelog 141).",
  "models": [
    {
      "name": "CartItem",
      "file": "Models/CartItem.cs",
      "properties": [
        {
          "name": "Id",
          "type": "int",
          "key": true
        },
        {
          "name": "UserId",
          "type": "string",
          "displayName": "Потребител",
          "validations": [
            {
              "attribute": "Required",
              "errorMessage": "Потребителят е задължителен."
            }
          ]
        },
        {
          "name": "$primaryModelId",
          "type": "int",
          "foreignKey": true
        },
        {
          "name": "Quantity",
          "type": "int",
          "displayName": "Количество",
          "validations": [
            {
              "attribute": "Range",
              "args": [
                1,
                99
              ],
              "errorMessage": "Количеството трябва да е между 1 и 99."
            }
          ]
        }
      ],
      "relations": [
        {
          "kind": "manyToOne",
          "target": "$primaryModel",
          "navigation": "$primaryModel",
          "inverseNavigation": "CartItems",
          "onDelete": "Cascade"
        }
      ],
      "displayName": "Артикули в кошница",
      "isLookup": true
    }
  ],
  "dtos": [],
  "controllers": []
}

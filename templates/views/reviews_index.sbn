@model IEnumerable<{{ meta.root_namespace }}.Models.Review>
@{
    ViewData["Title"] = "Отзиви";
    var targetUserId = (string?)ViewData["TargetUserId"];
}

<h1>Отзиви</h1>

@foreach (var review in Model)
{
    <div class="card mb-2">
        <div class="card-body">
            <div class="text-warning">
                @for (var i = 1; i <= 5; i++) { <span>@(i <= review.Stars ? "★" : "☆")</span> }
            </div>
            @if (review.Text is not null) { <p class="mb-1">@review.Text</p> }
            <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy")</small>
        </div>
    </div>
}

@if (User.Identity?.IsAuthenticated == true && targetUserId is not null)
{
    <form asp-action="Create" method="post" class="col-md-6 mt-4">
        <input type="hidden" name="targetUserId" value="@targetUserId" />
        <div class="mb-2">
            <label class="form-label">Оценка</label>
            <select class="form-select" name="stars">
                @for (var i = 5; i >= 1; i--) { <option value="@i">@i звезди</option> }
            </select>
        </div>
        <div class="mb-2">
            <textarea class="form-control" name="text" rows="3" placeholder="Вашият отзив (по избор)..."></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Публикувай отзив</button>
    </form>
}

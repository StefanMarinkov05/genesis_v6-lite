@model {{ meta.root_namespace }}.Models.Post
@{
    ViewData["Title"] = Model.Title;
    var currentUserId = (string?)ViewData["CurrentUserId"];
    var authorName = (string?)ViewData["AuthorName"];
    var score = Model.Votes.Sum(v => v.Value);
}

<h1>@Model.Title</h1>
<p class="text-muted mb-1">
    Публикувано от
    <a asp-area="Client" asp-controller="Profiles" asp-action="Public" asp-route-id="@ProfileHash.Of(Model.UserId)">@(authorName ?? "Профил на автора")</a>
</p>
@if (!string.IsNullOrEmpty(Model.ImagePath))
{
    <img src="/@Model.ImagePath" alt="@Model.Title" class="img-fluid rounded mb-3" style="max-height: 500px;" />
}
<p class="lead">@Model.Content</p>

<div class="d-flex gap-2 align-items-center mb-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="Vote" asp-route-id="@Model.Id" method="post" class="d-inline">
            <input type="hidden" name="value" value="1" />
            <button class="btn btn-sm btn-outline-success" type="submit">&#9650;</button>
        </form>
    }
    <strong>@score</strong>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-action="Vote" asp-route-id="@Model.Id" method="post" class="d-inline">
            <input type="hidden" name="value" value="-1" />
            <button class="btn btn-sm btn-outline-danger" type="submit">&#9660;</button>
        </form>
        @if (Model.UserId == currentUserId || User.IsInRole("{{ subst spec.identity.roles[0].name }}"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ms-auto"
                  onsubmit="return confirm('Изтриване на публикацията?');">
                <button class="btn btn-sm btn-outline-danger" type="submit">Изтрий</button>
            </form>
        }
    }
</div>

<h4>Коментари (@Model.Comments.Count)</h4>
@foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
{
    <div class="border-start ps-3 mb-2">
        <p class="mb-1">@comment.Content</p>
        @if (!string.IsNullOrEmpty(comment.ImagePath))
        {
            <img src="/@comment.ImagePath" alt="снимка към коментар" class="rounded mb-1" style="max-height: 140px; object-fit: cover;" />
        }
        <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
    </div>
}

@if (User.Identity?.IsAuthenticated == true)
{
    @* enctype="multipart/form-data" е задължително заради прикачената снимка (задача 14). *@
    <form asp-action="Comment" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3">
        <div class="mb-2">
            <textarea class="form-control" name="content" rows="3" maxlength="500"
                      placeholder="Вашият коментар..." required></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label" for="commentImage">Снимка към коментара (по избор)</label>
            <input class="form-control" id="commentImage" name="image" type="file" accept="image/*" />
        </div>
        <button class="btn btn-primary" type="submit">Коментирай</button>
    </form>
}
else
{
    <p class="text-muted mt-3"><a asp-area="Identity" asp-page="/Account/Login">Влезте</a>, за да коментирате.</p>
}

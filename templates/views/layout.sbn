<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - {{ meta.project_name }}</title>
    {{~ # Bootswatch тема от спецификацията (style.bootstrapTheme) ~}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/{{ effective_theme }}/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        header { position: sticky; top: 0; z-index: 1000; }
    </style>
{{~ if has_design ~}}
{{ design_overlay_html }}
{{~ end ~}}
</head>
{{~
has_contact = false
for c in spec.controllers; for a in c.actions; if a == "Contact"; has_contact = true; end; end; end
f_posts = false; f_orders = false; f_follows = false; f_rating = false; f_catalogues = false
~}}
@inject Microsoft.AspNetCore.Identity.UserManager<{{ meta.root_namespace }}.Models.ApplicationUser> UserManagerNav
{{~ if features.orders ~}}
@inject {{ meta.root_namespace }}.{{ meta.project_name }}Context NavCartContext
{{~ end ~}}
@{
    var navUser = User.Identity?.IsAuthenticated == true ? await UserManagerNav.GetUserAsync(User) : null;
}
<body>
<header>
    <nav class="navbar navbar-expand-lg {{ variation.axes.navbar_style }} mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">{{ meta.project_name }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
{{~ # Навигация: до 3 публични контролера inline, иначе dropdown "Разгледай" ~}}
{{~ public_controllers = [] ~}}
{{~ for c in spec.controllers; if c.area == null || c.area == "Client"; public_controllers = public_controllers | array.add c; end; end ~}}
{{~ if public_controllers.size <= 3 ~}}
{{~ for c in public_controllers ~}}
{{~ short = c.name | string.replace "Controller" "" ~}}
{{~ if c.display_name; label = c.display_name; else; label = short; end ~}}
{{~ if short != "Home" ~}}
                    <li class="nav-item">
                        <a class="nav-link" asp-area="{{ if c.area }}{{ c.area }}{{ end }}" asp-controller="{{ short }}" asp-action="Index">{{ label }}</a>
                    </li>
{{~ end ~}}
{{~ end ~}}
{{~ else ~}}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Разгледай</a>
                        <ul class="dropdown-menu">
{{~ for c in public_controllers ~}}
{{~ short = c.name | string.replace "Controller" "" ~}}
{{~ if c.display_name; label = c.display_name; else; label = short; end ~}}
{{~ if short != "Home" ~}}
                            <li><a class="dropdown-item" asp-area="{{ if c.area }}{{ c.area }}{{ end }}" asp-controller="{{ short }}" asp-action="Index">{{ label }}</a></li>
{{~ end ~}}
{{~ end ~}}
                        </ul>
                    </li>
{{~ end ~}}
{{~ # Административно меню - само за администраторска роля ~}}
{{~ admin_role = "" ~}}
{{~ for r in spec.identity.roles; if r.is_admin; admin_role = r.name; end; end ~}}
{{~ if has_contact ~}}
                    <li class="nav-item"><a class="nav-link" asp-area="{{ if meta.routing.default_area }}{{ meta.routing.default_area }}{{ end }}" asp-controller="Home" asp-action="Contact">Контакти</a></li>
{{~ end ~}}
{{~ if features.catalogues ~}}
                    <li class="nav-item"><a class="nav-link" asp-area="Client" asp-controller="Catalogues" asp-action="Public">Публични каталози</a></li>
{{~ end ~}}
                    @if (User.Identity?.IsAuthenticated == true)
                    {
{{~ # Автентикирани връзки за включените функционалности ~}}
{{~ any_feature = features.catalogues || features.orders || features.follows || features.rating || features.posts ~}}
{{~ if any_feature ~}}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Моето</a>
                            <ul class="dropdown-menu">
{{~ if features.posts ~}}
                                <li><a class="dropdown-item" asp-area="Client" asp-controller="Posts" asp-action="Index">Публикации</a></li>
{{~ end ~}}
{{~ if features.catalogues ~}}
                                <li><a class="dropdown-item" asp-area="Client" asp-controller="Catalogues" asp-action="Index">Каталози</a></li>
{{~ end ~}}
{{~ if features.orders ~}}
                                <li><a class="dropdown-item" asp-area="Client" asp-controller="Cart" asp-action="Orders">Поръчки</a></li>
{{~ end ~}}
{{~ if features.follows ~}}
                                <li><a class="dropdown-item" asp-area="Client" asp-controller="Follows" asp-action="List">Последователи и следвани</a></li>
{{~ end ~}}
                            </ul>
                        </li>
{{~ end ~}}
                    }
                    @if (User.IsInRole("{{ admin_role }}"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Администрация</a>
                            <ul class="dropdown-menu">
{{~ any_specifications = false ~}}
{{~ for c in spec.controllers; if c.area == "Admin" && !c.is_lookup && !c.is_specification && c.name != "SpecificationsController" ~}}
{{~ short = c.name | string.replace "Controller" "" ~}}
{{~ if c.display_name; label = c.display_name; else; label = short; end ~}}
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="{{ short }}" asp-action="Index">{{ label }}</a></li>
{{~ end; end ~}}
{{~ for c in spec.controllers; if c.area == "Admin" && (c.is_lookup || c.is_specification); any_specifications = true; end; end ~}}
{{~ if !any_specifications && features.rating; any_specifications = true; end ~}}
{{~ if any_specifications ~}}
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Specifications" asp-action="Index">Спецификации</a></li>
{{~ end ~}}
{{~ if spec.identity.application_user.controller ~}}
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Потребители</a></li>
{{~ end ~}}
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
{{~ has_first_name = false; has_pfp = false ~}}
{{~ if spec.identity ~}}
{{~ for ep in spec.identity.application_user.extra_properties ~}}
{{~ if ep.name == "FirstName"; has_first_name = true; end ~}}
{{~ if ep.name == "ProfilePicturePath"; has_pfp = true; end ~}}
{{~ end ~}}
{{~ end ~}}
                        <li class="nav-item">
                            <span class="nav-link">Здравей, @({{ if has_first_name }}!string.IsNullOrEmpty(navUser?.FirstName) ? navUser!.FirstName : {{ end }}User.Identity.Name)!</span>
                        </li>
{{~ if has_pfp ~}}
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Профил">
                                <img src="@(string.IsNullOrEmpty(navUser?.ProfilePicturePath) ? "/images/avatar-default.svg" : "/" + navUser!.ProfilePicturePath)"
                                     alt="профил" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                            </a>
                        </li>
{{~ end ~}}
{{~ if features.orders ~}}
                        <li class="nav-item">
                            @{
                                var cartCount = navUser is not null
                                    ? NavCartContext.CartItems.Count(i => i.UserId == navUser.Id)
                                    : 0;
                            }
                            <a class="nav-link" asp-area="Client" asp-controller="Cart" asp-action="Index">
                                &#128722;
                                <span class="badge bg-danger cart-badge">@cartCount</span>
                            </a>
                        </li>
{{~ end ~}}
                        <li class="nav-item">
                            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post"
                                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button type="submit" class="btn btn-link nav-link">Изход</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Вход</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    @if (TempData["Error"] is string tempError)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @tempError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }
    @if (TempData["Success"] is string tempSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @tempSuccess
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Затвори"></button>
        </div>
    }
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>
{{~ if spec.views.layout.footer ~}}
<footer class="border-top footer text-muted mt-4">
    <div class="container py-3">
        &copy; @DateTime.Now.Year - {{ meta.project_name }}
    </div>
</footer>
{{~ end ~}}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

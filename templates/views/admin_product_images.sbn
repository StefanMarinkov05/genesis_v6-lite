@model List<{{ meta.root_namespace }}.Models.{{ model.name }}Image>
@{
    ViewData["Title"] = "Снимки — " + ViewData["ParentName"];
    var parentId = (int)ViewData["ParentId"]!;
}

<h2>Снимки за: <em>@ViewData["ParentName"]</em></h2>

{{~ if model.images.mode == "single" ~}}
{{~ # Режим single: една текуща снимка, качването я замества (ImageService го прави и служебно). ~}}
@if (Model.Any())
{
    var current = Model[0];
    <div class="mb-3" style="max-width: 260px;">
        <img src="/@current.RelativePath" class="img-fluid rounded shadow-sm mb-2" alt="снимка" />
        <form asp-area="Admin" asp-controller="{{ model.name }}Images"
              asp-action="DeleteImage" method="post"
              onsubmit="return confirm('Премахване на снимката?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@parentId" />
            <input type="hidden" name="imageId" value="@current.Id" />
            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Премахни снимката</button>
        </form>
    </div>
}
else
{
    <p class="text-muted">Все още няма качена снимка.</p>
}

<h5 class="mb-2">Качи снимка</h5>
<form asp-area="Admin" asp-controller="{{ model.name }}Images"
      asp-action="Upload" asp-route-id="@parentId"
      method="post" enctype="multipart/form-data" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <input class="form-control" name="files" type="file" accept="image/*" />
        <div class="form-text">JPG, PNG до 5 MB. Качването на нова снимка заменя текущата.</div>
    </div>
    <button type="submit" class="btn btn-primary">Качи</button>
</form>
{{~ else ~}}
@if (!Model.Any())
{
    <p class="text-muted">Все още няма качени снимки.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
        @foreach (var img in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="/@img.RelativePath" class="card-img-top"
                         style="height: 130px; object-fit: cover;" alt="снимка" />
                    <div class="card-footer text-center p-1">
                        <form asp-area="Admin" asp-controller="{{ model.name }}Images"
                              asp-action="DeleteImage" method="post"
                              onsubmit="return confirm('Изтриване на снимката?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@parentId" />
                            <input type="hidden" name="imageId" value="@img.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Изтрий</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h5 class="mb-2">Добави снимки</h5>
<form asp-area="Admin" asp-controller="{{ model.name }}Images"
      asp-action="Upload" asp-route-id="@parentId"
      method="post" enctype="multipart/form-data" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <input class="form-control" name="files" type="file" accept="image/*" multiple />
        <div class="form-text">JPG, PNG до 5 MB на файл. Можете да изберете няколко наведнъж.</div>
    </div>
    <button type="submit" class="btn btn-primary">Качи</button>
</form>
{{~ end ~}}

<a class="btn btn-outline-secondary"
   asp-area="Admin" asp-controller="{{ model.name }}s" asp-action="Index">Назад към списъка</a>

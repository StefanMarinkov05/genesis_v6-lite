@model IEnumerable<{{ meta.root_namespace }}.Models.CartItem>
@{
    ViewData["Title"] = "Количка";
{{~
display = "Id"
for tm in spec.models
  if tm.name == primary
    for tp in tm.properties; if !tp.key && tp.type == "string" && display == "Id"; display = tp.name; end; end
  end
end
~}}
    var total = Model.Sum(i => (i.{{ primary }}?.{{ price_property }} ?? 0) * i.Quantity);
}

<h1>Количка</h1>

@if (!Model.Any())
{
    <p class="text-muted">Количката е празна.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Артикул</th><th>Количество</th><th>Цена</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.{{ primary }}?.{{ display }}</td>
                    <td>@item.Quantity</td>
                    <td>@(((item.{{ primary }}?.{{ price_property }} ?? 0) * item.Quantity).ToString("F2")) лв.</td>
                    <td>
                        <form asp-action="Remove" asp-route-id="@item.Id" method="post">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Премахни</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
{{~ if features.orders ~}}
    <form asp-action="Checkout" method="post" class="mt-4">
        <h5 class="mb-3">Данни за доставка</h5>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Получател *</label>
                <input class="form-control" name="receiverName" placeholder="Три имена" maxlength="200" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Адрес за доставка *</label>
                <textarea class="form-control" name="deliveryAddress" rows="2" placeholder="Град, ул., №..." maxlength="500" required></textarea>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center">
            <h4>Общо: @total.ToString("F2") лв.</h4>
            <button class="btn btn-lg btn-success" type="submit">Поръчай</button>
        </div>
    </form>
{{~ else ~}}
    <h4 class="mt-4">Общо: @total.ToString("F2") лв.</h4>
{{~ end ~}}
}

@model IEnumerable<{{ meta.root_namespace }}.Models.Order>
@{
    ViewData["Title"] = "Моите поръчки";
}

<h1>Моите поръчки</h1>

@if (!Model.Any())
{
    <p class="text-muted">Все още нямате поръчки.</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Номер</th><th>Дата</th><th>Артикули</th><th>Обща сума</th><th>Статус</th><th></th></tr></thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.Items.Sum(i => i.Quantity)</td>
                    <td>@order.Total.ToString("F2") лв.</td>
                    <td>@Html.DisplayFor(modelItem => order.Status)</td>
                    <td><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Детайли</a></td>
                </tr>
            }
        </tbody>
    </table>
}

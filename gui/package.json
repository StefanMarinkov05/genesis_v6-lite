{
  "name": "dps-nn-gui",
  "version": "6.6.6",
  "description": "ДПС-НН GUI — Electron shell over the headless Genesis CLI (spec B.0 MVP)",
  "private": true,
  "author": "Stefan Marinkov",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node scripts/dev.js preview",
    "test:runner": "node --test \"test/**/*.test.ts\"",
    "stage": "node scripts/stage-genesis.mjs",
    "dist": "npm run build && node scripts/stage-genesis.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  }
}

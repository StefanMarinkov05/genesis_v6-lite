<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
      <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <ProjectReference Include="..\..\src\Genesis.Core\GenesisV6.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
    <None Include="..\..\templates\**" CopyToOutputDirectory="PreserveNewest" LinkBase="templates" />
    <None Include="..\..\feature-templates\**" CopyToOutputDirectory="PreserveNewest" LinkBase="feature-templates" />
    <None Include="..\..\spec.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
